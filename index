        let currentLang = 'id';

        function setDailyMotivation(lang) {
            const now = new Date();
            const start = new Date(now.getFullYear(), 0, 0);
            const diff = (now - start) + ((start.getTimezoneOffset() - now.getTimezoneOffset()) * 60 * 1000);
            const dayOfYear = Math.floor(diff / (1000 * 60 * 60 * 24));
            
            const list = motivations[lang];
            const selected = list[dayOfYear % list.length];
            
            document.getElementById('daily-motivation-quote').textContent = `"${selected.quote}"`;
            document.getElementById('daily-motivation-author').textContent = selected.author;
        }

        function changeLanguage(lang) {
            currentLang = lang;
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang][key]) {
                    el.textContent = translations[lang][key];
                }
            });
            setDailyMotivation(lang);
        }

        // Tab Switching Logic (Each sidebar item shows its own unique section)
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => {
                el.classList.add('hidden');
            });
            document.getElementById('tab-' + tabId).classList.remove('hidden');

            // Update active states on sidebar buttons
            const navButtons = document.querySelectorAll('aside nav button');
            navButtons.forEach(btn => {
                btn.className = "w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/50 transition text-left";
            });

            const activeBtn = document.getElementById('nav-btn-' + tabId);
            if (activeBtn) {
                activeBtn.className = "w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl bg-brand-50 dark:bg-brand-900/30 text-brand-600 dark:text-brand-400 font-medium transition text-left";
            }

            // Close mobile sidebar on select
            if (window.innerWidth < 768) {
                toggleSidebar();
            }
        }

        // Sidebar Toggle for Mobile
        const sidebar = document.getElementById('sidebar');
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const sidebarClose = document.getElementById('sidebar-close');
        const sidebarOverlay = document.getElementById('sidebar-overlay');

        function toggleSidebar() {
            sidebar.classList.toggle('-translate-x-full');
            sidebarOverlay.classList.toggle('hidden');
        }

        sidebarToggle.addEventListener('click', toggleSidebar);
        sidebarClose.addEventListener('click', toggleSidebar);
        sidebarOverlay.addEventListener('click', toggleSidebar);

        // Theme Toggle Logic
        const htmlElement = document.documentElement;
        const desktopThemeIcon = document.getElementById('desktop-theme-icon');
        const mobileThemeIcon = document.getElementById('mobile-theme-icon');
        const themeText = document.getElementById('theme-text');

        function updateThemeUI(isDark) {
            if (isDark) {
                desktopThemeIcon.className = 'fa-solid fa-sun';
                mobileThemeIcon.className = 'fa-solid fa-sun';
                themeText.textContent = currentLang === 'id' ? 'Mode Terang' : 'Light Mode';
            } else {
                desktopThemeIcon.className = 'fa-solid fa-moon';
                mobileThemeIcon.className = 'fa-solid fa-moon';
                themeText.textContent = currentLang === 'id' ? 'Mode Gelap' : 'Dark Mode';
            }
        }

        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            htmlElement.classList.add('dark');
            updateThemeUI(true);
        } else {
            htmlElement.classList.remove('dark');
            updateThemeUI(false);
        }

        function toggleTheme() {
            if (htmlElement.classList.contains('dark')) {
                htmlElement.classList.remove('dark');
                localStorage.theme = 'light';
                updateThemeUI(false);
            } else {
                htmlElement.classList.add('dark');
                localStorage.theme = 'dark';
                updateThemeUI(true);
            }
        }

        // Live Clock & Date
        function updateClock() {
            const now = new Date();
            const optionsDate = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const dateStr = now.toLocaleDateString(currentLang === 'id' ? 'id-ID' : 'en-US', optionsDate);
            const timeStr = now.toTimeString().split(' ')[0];

            document.getElementById('live-date').textContent = dateStr;
            document.getElementById('live-time').textContent = timeStr;
            document.getElementById('mobile-live-date').textContent = dateStr;
            document.getElementById('mobile-live-time').textContent = timeStr;
        }
        setInterval(updateClock, 1000);
        updateClock();

